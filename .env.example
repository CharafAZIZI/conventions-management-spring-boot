# Copier ce fichier en ".env" puis renseigner les valeurs.
# Le fichier .env ne doit JAMAIS être commité.

# ---- SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=blconvento
DB_USER=<utilisateur_applicatif>
DB_PASSWORD=<mot_de_passe_fort>
# true en local (certificat auto-signé), false en production
DB_TRUST_SERVER_CERT=true

# ---- Serveur
SERVER_PORT=8080
# Mettre true derrière HTTPS
COOKIE_SECURE=false

# ---- Fichiers PDF téléversés (hors dépôt)
APP_UPLOAD_DIR=./uploads/conventions

# ---- Hibernate : update en local, validate en production
JPA_DDL_AUTO=update

# ---- Thymeleaf : false en développement (rechargement), true en production
THYMELEAF_CACHE=false
